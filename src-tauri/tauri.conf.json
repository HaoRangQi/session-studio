{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Studio",
  "version": "0.1.0",
  "identifier": "local.session-studio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Session Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self' asset:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420" }
  },
  "bundle": { "active": false, "icon": [] }
}
